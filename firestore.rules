rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for authorized Super Administrator
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'kumaraman19137@gmail.com';
    }

    // 1. Private User root document and personal subcollections
    // (reading_progress, favorites, bookmarks, daily_activity, etc.)
    function isOwnerOrAdmin(userId) {
      return request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId} {
      allow read, write: if isOwnerOrAdmin(userId);

      // users/{uid}/data/* — the entitlement doc is written only by the server (Admin SDK bypasses rules)
      match /data/{docId} {
        allow read: if isOwnerOrAdmin(userId);
        allow write: if isOwnerOrAdmin(userId) && (docId != 'entitlement' || isAdmin());
      }

      // All other personal subcollections (reading_progress, favorites, backups, ...)
      match /{collectionId}/{document=**} {
        allow read, write: if collectionId != 'data' && isOwnerOrAdmin(userId);
      }
    }

    match /users {
      allow list: if isAdmin();
    }

    // 2. Public User Profiles (Instagram + LeetCode social layer)
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 3. Unique Username Registry (@username)
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.uid || isAdmin());
      // Only the current owner may update a claimed username, and it must stay theirs
      allow update: if request.auth != null && (
                      (request.auth.uid == resource.data.uid && request.auth.uid == request.resource.data.uid)
                      || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // 4. Follow Relationships (${followerUid}_${followingUid})
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.auth.uid == request.resource.data.followerUid 
                    && request.resource.data.followerUid != request.resource.data.followingUid
                    && followId == request.resource.data.followerUid + '_' + request.resource.data.followingUid;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.followerUid || isAdmin());
    }

    // 5. Public Reading Activities
    match /public_activities/{activityId} {
      allow read: if true;
      allow create: if request.auth != null && (request.auth.uid == request.resource.data.uid || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == resource.data.uid || isAdmin());
    }

    // 6. Catalog Overrides (Dynamic book soft delete & metadata overrides)
    match /catalog_overrides/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Curated Series Overrides (Platform reading paths/series management)
    match /curated_series_overrides/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Admin Audit Logs (Sensitive action audit trail - ADMIN ONLY)
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: false;
    }
  }
}
